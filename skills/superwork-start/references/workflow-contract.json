{
  "schemaVersion": 3,
  "implicitEntry": "superwork-start",
  "skills": [
    "superwork-init",
    "superwork-start",
    "superwork-planning",
    "superwork-executing-plans",
    "superwork-tdd",
    "superwork-debugging",
    "superwork-check"
  ],
  "continuationPolicy": {
    "default": "complete",
    "stopCondition": "explicit-user-instruction"
  },
  "handoffContract": {
    "requiredFields": [
      "target",
      "caller",
      "outcome",
      "evidence",
      "stopConditions",
      "returnTo"
    ],
    "loadTargetSkill": "read-once-per-run",
    "targetPath": "../{target}/SKILL.md"
  },
  "planContract": {
    "format": "single-markdown-file",
    "taskHeading": "### Task <number>: <title>",
    "executionOrder": "first-unchecked-task",
    "statusMarker": "Task Status",
    "requiredHeader": [
      "Goal",
      "Scope",
      "Acceptance"
    ],
    "taskFields": [
      "Files",
      "Behavior",
      "Proof",
      "Stop Conditions",
      "Task Status"
    ],
    "optionalTaskFields": [
      "Interfaces"
    ]
  },
  "routes": {
    "analysis": "direct-response",
    "bug": "superwork-debugging",
    "development": "superwork-tdd",
    "planning": "superwork-planning",
    "resume": "superwork-executing-plans",
    "verification": "superwork-check"
  },
  "phaseTransitions": [
    {
      "from": "superwork-start",
      "to": "superwork-debugging"
    },
    {
      "from": "superwork-start",
      "to": "superwork-planning"
    },
    {
      "from": "superwork-start",
      "to": "superwork-check"
    },
    {
      "from": "superwork-start",
      "to": "superwork-executing-plans"
    },
    {
      "from": "superwork-planning",
      "to": "superwork-check"
    },
    {
      "from": "superwork-executing-plans",
      "to": "superwork-check"
    },
    {
      "from": "superwork-debugging",
      "to": "superwork-check"
    }
  ],
  "methodCalls": [
    {
      "caller": "superwork-start",
      "method": "superwork-tdd",
      "returnsTo": "superwork-start"
    },
    {
      "caller": "superwork-executing-plans",
      "method": "superwork-tdd",
      "returnsTo": "superwork-executing-plans"
    },
    {
      "caller": "superwork-planning",
      "method": "superwork-tdd",
      "returnsTo": "superwork-planning"
    },
    {
      "caller": "superwork-debugging",
      "method": "superwork-tdd",
      "returnsTo": "superwork-debugging"
    }
  ],
  "completionSkill": "superwork-check"
}
